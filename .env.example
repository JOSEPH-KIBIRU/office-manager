# ---- Security ----
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Seeded director/admin account (created on first run) ----
ORG_NAME=My Company Ltd
ADMIN_NAME=Director
ADMIN_EMAIL=director@office.local
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMe123!

# ---- Platform Owner / Superadmin account (created on first run) ----
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=platform@office.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!

# ---- Resend (email) ----
RESEND_API_KEY=
EMAIL_FROM=Office Manager <onboarding@resend.dev>

# ---- OpenAI (AI minutes generation) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- TalkSasa (SMS) ----
TALKSASA_API_KEY=
TALKSASA_SENDER_ID=
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3

# ---- App ----
APP_URL=http://localhost:3000

# ---- Convex (backend database) ----
# NEXT_PUBLIC_CONVEX_URL is written to .env.local by `npx convex dev` / `npx convex deployment select`.
CONVEX_SERVER_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Multi-tenancy ----
# ORG_NAME names the default organization seeded on first run.
# Register additional companies (each with their own admin) with:
#   node scripts/create-company.mjs "Company Name" admin@company.com "Admin Name"
