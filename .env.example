# ---- Security ----
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Vercel Cron / sync runners send Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# ---- UploadThing (file storage) ----
# Required: documents, minutes, task photos and logos are uploaded directly to
# UploadThing; only their URLs/keys are stored in Convex.
UPLOADTHING_TOKEN=
# Set to "true" after upgrading UploadThing to a paid app. New uploads then use
# private ACL and /api/files/u/<key> issues short-lived signed URLs.
UPLOADTHING_PRIVATE=
# Optional external antivirus scanner. It receives the decrypted file as a
# multipart POST and must return JSON: { "clean": true } or
# { "clean": false, "reason": "..." }.
UPLOAD_SCAN_URL=
UPLOAD_SCAN_TOKEN=
# Set true only if you prefer uploads to proceed when the external scanner is down.
UPLOAD_SCAN_FAIL_OPEN=false

# ---- Seeded director/admin account (created on first run) ----
ORG_NAME=My Company Ltd
ADMIN_NAME=Director
ADMIN_EMAIL=director@office.local
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMe123!

# ---- Platform Owner / Superadmin account (created on first run) ----
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=platform@office.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!

# ---- Resend (email) ----
RESEND_API_KEY=
EMAIL_FROM=Office Manager <onboarding@resend.dev>

# ---- AI (minutes + CRM leads). Use DeepSeek or any OpenAI-compatible endpoint.
# Reuses DEEPSEEK_API_KEY; CRM_AI_* override it for the CRM only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
CRM_AI_API_KEY=
CRM_AI_BASE_URL=https://api.deepseek.com
CRM_AI_MODEL=deepseek-v4-flash
# Review unlinked inbound email after the daily sync and create leads.
CRM_AI_AUTO_REVIEW=true
CRM_AI_AUTO_REVIEW_LIMIT=1
# Follow-up automation thresholds (used by the daily cron and Run follow-ups).
CRM_STALE_LEAD_DAYS=3
CRM_STALE_DEAL_DAYS=7
CRM_LEAD_SLA_HOURS=24
CRM_QUOTE_FOLLOWUP_DAYS=3

# ---- TalkSasa (SMS) ----
TALKSASA_API_KEY=
TALKSASA_SENDER_ID=
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3

# ---- App ----
APP_URL=http://localhost:3000

# ---- Calendar integrations (Google Calendar / Microsoft Outlook) ----# Register these redirect URIs in the OAuth apps:
#   {APP_URL}/api/integrations/google/callback
#   {APP_URL}/api/integrations/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# base64-encoded 32-byte key used to encrypt stored OAuth tokens: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# shared secret that authorises the calendar sync runner (/api/integrations/sync/run)
CALENDAR_SYNC_SECRET=

# ---- Convex (backend database) ----
# NEXT_PUBLIC_CONVEX_URL is written to .env.local by `npx convex dev` / `npx convex deployment select`.
CONVEX_SERVER_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Sentry (error monitoring) ----
# Optional. Leave NEXT_PUBLIC_SENTRY_DSN blank to disable error reporting.
# Get the DSN from sentry.io → your project → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for uploading source maps at build time (readable stack traces).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Multi-tenancy ----
# ORG_NAME names the default organization seeded on first run.
# Register additional companies (each with their own admin) with:
#   node scripts/create-company.mjs "Company Name" admin@company.com "Admin Name"
