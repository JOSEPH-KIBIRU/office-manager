# ---- Security ----
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Seeded director/admin account (created on first run) ----
ORG_NAME=My Company Ltd
ADMIN_NAME=Director
ADMIN_EMAIL=director@office.local
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMe123!

# ---- Platform Owner / Superadmin account (created on first run) ----
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=platform@office.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!

# ---- Resend (email) ----
RESEND_API_KEY=
EMAIL_FROM=Office Manager <onboarding@resend.dev>

# ---- OpenAI (AI minutes generation) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- TalkSasa (SMS) ----
TALKSASA_API_KEY=
TALKSASA_SENDER_ID=
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3

# ---- UploadThing (task image uploads) ----
# From https://uploadthing.com/dashboard → your app → API Keys
UPLOADTHING_TOKEN=

# ---- App ----
APP_URL=http://localhost:3000

# ---- Calendar integrations (Google Calendar / Microsoft Outlook) ----# Register these redirect URIs in the OAuth apps:
#   {APP_URL}/api/integrations/google/callback
#   {APP_URL}/api/integrations/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# base64-encoded 32-byte key used to encrypt stored OAuth tokens: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# shared secret that authorises the calendar sync runner (/api/integrations/sync/run)
CALENDAR_SYNC_SECRET=

# ---- Convex (backend database) ----
# NEXT_PUBLIC_CONVEX_URL is written to .env.local by `npx convex dev` / `npx convex deployment select`.
CONVEX_SERVER_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Sentry (error monitoring) ----
# Optional. Leave NEXT_PUBLIC_SENTRY_DSN blank to disable error reporting.
# Get the DSN from sentry.io → your project → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for uploading source maps at build time (readable stack traces).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Multi-tenancy ----
# ORG_NAME names the default organization seeded on first run.
# Register additional companies (each with their own admin) with:
#   node scripts/create-company.mjs "Company Name" admin@company.com "Admin Name"
